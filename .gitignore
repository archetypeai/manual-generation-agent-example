# Secrets — never commit. Contains a live dev API key.
.env
.env.*
!.env.example

# Videos are copyrighted by their uploaders and must never be committed.
# data/ is ignored wholesale; *.mp4 is a backstop for a stray download.
data/
*.mp4
*.mkv
*.webm
repro-A.jsonl
repro-B.jsonl

# Source video and any derived clips. Large, and licensed by whoever published
# them — see the README's Data attribution section before redistributing.
data/raw/
data/clips/

# Agent run outputs — regenerable, named per-clip at runtime.
# Run outputs land at the repo root by default. Anchored with a leading slash so
# the curated copies under reference/ stay tracked.
/mga-output*
/repro*.jsonl
/*.jsonl
eval_out/
eval_out_*/

# Raw API responses from inspect_bundle.py — a snapshot of dev, not source.
discovery/

# Python
__pycache__/
*.py[cod]
.venv/

.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# Internal design doc — kept locally, not published with the example.
docs/Manual Generation Agent.md

# --background output (sweep_serve.py)
logs/

# Lifecycle 2.0 ids: the project, copies, packages, deployments and sessions
state/
